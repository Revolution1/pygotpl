{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Revolution1/pygotpl/benchmarks/profile-schema.json",
  "title": "pygotpl comprehensive profile suite",
  "type": "object",
  "required": ["schema_version", "environment", "configuration", "workloads"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "configuration": {"type": "object"},
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "deterministic", "sampling", "allocation"]
      }
    }
  },
  "additionalProperties": false
}
