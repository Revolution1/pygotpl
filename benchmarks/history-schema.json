{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Revolution1/pygotpl/benchmarks/history-schema.json",
  "title": "pygotpl historical benchmark bundle",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "revision",
    "samples",
    "environment",
    "comparisons"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "string", "minLength": 1},
    "samples": {"type": "integer", "minimum": 1},
    "environment": {
      "type": "object",
      "required": ["python", "go", "platform", "machine"],
      "additionalProperties": {"type": "string"}
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
