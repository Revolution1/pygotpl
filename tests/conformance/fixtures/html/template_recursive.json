    "name": "html-template-recursive",
    "template": "{{template \"tree\" .}}{{define \"tree\"}}{{if .Children}}<ul>{{range .Children}}<li>{{template \"tree\" .}}</li>{{end}}</ul>{{else}}{{.X}}{{end}}{{end}}",
    "data": {
      "Children": [
        {"X": "foo"},
        {"X": "<bar>"},
        {"Children": [{"X": "baz"}]}
      ]
    }
  },
  "expected": {
    "output": "<ul><li>foo</li><li>&lt;bar&gt;</li><li><ul><li>baz</li></ul></li></ul>",
    "error": null
  }
